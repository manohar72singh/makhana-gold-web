# 1. Base Domain URL
NEXT_PUBLIC_APP_URL="https://makhanagold.com"

# 2. Database Connection (Prisma + MariaDB / MySQL)
# ------------------------------------------------------------------------------
# Local Development:
DATABASE_URL="mysql://root:123456@127.0.0.1:3306/makhana_gold"

# Hostinger VPS / Cloud / hPanel Deployment:
# Format: mysql://<DB_USER>:<DB_PASSWORD>@127.0.0.1:3306/<DB_NAME>?connection_limit=15
# Example: DATABASE_URL="mysql://u440110284_admin:YourStrongPassword@127.0.0.1:3306/u440110284_makhanagold?connection_limit=15"
# If using Unix domain socket on Linux/Hostinger:
# DB_SOCKET_PATH="/var/run/mysqld/mysqld.sock"
#
# Optional fine-tuning:
# DB_CONNECTION_LIMIT=15
# DB_CONNECT_TIMEOUT=15000
# DB_ACQUIRE_TIMEOUT=15000

