# ===================================================
# MAKHANA GOLD WEB APPLICATION - ENVIRONMENT TEMPLATE
# Copy this file to .env and fill in your real credentials.
# NEVER commit your actual .env file to Git!
# ===================================================

# App Base Domain URL
NEXT_PUBLIC_APP_URL="https://makhanagold.com"

# Database Connection (Prisma + MariaDB/MySQL)
DATABASE_URL="mysql://root:password@localhost:3306/makhana_gold"

# Auth.js / NextAuth v5 Secret Key
AUTH_SECRET="generate_with_openssl_rand_base64_32"

# Google OAuth 2.0 (Continue with Google)
AUTH_GOOGLE_ID="your_google_client_id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your_google_client_secret"
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Razorpay Online Payment Gateway
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Email & Notification Engine (Direct Gmail SMTP / Custom SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="orders@makhanagold.com"
SMTP_PASS="your_gmail_app_password"
EMAIL_FROM="Makhana Gold <orders@makhanagold.com>"
SUPPORT_EMAIL="support@makhanagold.com"

# Shiprocket Logistics & Courier API
SHIPROCKET_EMAIL="your_shiprocket_email@example.com"
SHIPROCKET_PASSWORD="your_shiprocket_password"
SHIPROCKET_API_TOKEN=""
SHIPROCKET_PICKUP_PINCODE="110001"
SHIPROCKET_PICKUP_LOCATION_NAME="Primary Warehouse"

# Delhivery Direct API (Optional)
DELHIVERY_API_TOKEN=""
